{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAcrossServices",
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets", "s3:ListBucket", "s3:GetObject", "s3:GetObjectVersion",
        "s3:GetBucketAcl", "s3:GetBucketPolicy",
        "ec2:Describe*",
        "lambda:ListFunctions", "lambda:GetFunction",
        "dynamodb:ListTables", "dynamodb:DescribeTable", "dynamodb:GetItem", "dynamodb:Query",
        "kms:ListKeys", "kms:DescribeKey", "kms:Decrypt",
        "cloudtrail:DescribeTrails", "cloudtrail:GetTrailStatus", "cloudtrail:LookupEvents",
        "logs:DescribeLogGroups", "logs:GetLogEvents",
        "secretsmanager:ListSecrets", "secretsmanager:DescribeSecret", "secretsmanager:GetSecretValue",
        "ssm:DescribeParameters", "ssm:GetParameter",
        "rds:DescribeDBInstances",
        "sts:GetCallerIdentity", "sts:GetSessionToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "OperationalWrites",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject", "s3:CopyObject", "s3:CreateBucket",
        "ec2:CreateTags", "ec2:StartInstances", "ec2:StopInstances",
        "lambda:InvokeFunction",
        "dynamodb:PutItem", "dynamodb:UpdateItem",
        "kms:Encrypt",
        "logs:CreateLogGroup", "logs:PutLogEvents",
        "ssm:PutParameter",
        "rds:CreateDBSnapshot"
      ],
      "Resource": "*"
    }
  ]
}
