{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BroadServiceAccess",
      "Effect": "Allow",
      "Action": [
        "s3:*",
        "ec2:*",
        "lambda:*",
        "dynamodb:*",
        "kms:*",
        "cloudtrail:*",
        "logs:*",
        "secretsmanager:*",
        "ssm:*",
        "rds:*",
        "sts:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IamReadOnly",
      "Effect": "Allow",
      "Action": [
        "iam:List*",
        "iam:Get*"
      ],
      "Resource": "*"
    }
  ]
}
